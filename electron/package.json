{
  "name": "diskgoup-electron",
  "private": true,
  "author": {
    "name": "Elshad Aghayev",
    "url": "https://github.com/elshadaghazade"
  },
  "license": "MIT",
  "homepage": "https://diskgoup.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/elshadaghazade/diskgoup.git"
  },
  "version": "0.4.2",
  "description": "Electron wrapper for DiskGOup \u2014 bundles the Vite UI and the compiled CLI binary.",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf dist resources/diskgoup",
    "build:electron": "tsc",
    "build:cli": "node scripts/build-cli.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build": "npm run clean && npm run build:electron && npm run build:cli && npm run build:assets",
    "dev:electron": "tsc -w",
    "dev": "npm run build:electron && npm run build:cli && cross-env DISKGOUP_ELECTRON_DEV=1 electron .",
    "start": "electron .",
    "verify:signature": "node scripts/verify-signature.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:x64": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "app.diskgoup.desktop",
    "productName": "DiskGOup",
    "afterSign": "./scripts/verify-signature.mjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/diskgoup",
        "to": "diskgoup",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "notarize": true,
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "artifactName": "DiskGOup-macOS-${arch}.${ext}",
      "identity": "-",
      "forceCodeSigning": true,
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DiskGOup-Windows-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "DiskGOup-Windows-portable-${arch}.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "DiskGOup-Linux-${arch}.${ext}",
      "category": "Utility"
    },
    "dmg": {
      "title": "DiskGOup ${version}"
    }
  }
}
