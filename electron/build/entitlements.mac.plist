<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript at runtime, so it needs both of these under
         the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The Electron framework is signed by Electron's team, not ours, and
         macOS otherwise refuses to load a library that carries a different
         team ID. Every Electron app needs this exception to run under the
         hardened runtime - and Apple requires the hardened runtime for
         notarization. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
